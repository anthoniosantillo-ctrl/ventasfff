# Copia este archivo como .env (o pon estas variables en tu hosting) y llénalas.
PAYPAL_CLIENT_ID=pega_aqui_tu_client_id
PAYPAL_SECRET=pega_aqui_tu_secret
# sandbox = pruebas con dinero falso | live = dinero real
PAYPAL_ENV=sandbox
# Dirección pública de tu página, sin "/" al final
SITIO_URL=https://tu-pagina.com
# Solo si la página está alojada en OTRO dominio distinto al servidor, pon aquí la dirección de la página
ORIGEN_PERMITIDO=
COMISION_RECARGA=2.25
